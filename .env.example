# Supabase Configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=replace_me_server_only
# Note: SUPABASE_SERVICE_ROLE_KEY should only be used on the server.
# For client-side (if needed), use VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY.

# Google Search API
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# GOWA WhatsApp API (go-whatsapp-web-multidevice)
# Runs on VPS at https://whatsapp.eburon.ai
GOWA_API_URL=https://whatsapp.eburon.ai
GOWA_USERNAME=admin
GOWA_PASSWORD=replace_me_server_only
GOWA_DEVICE_ID=beatrice
GOWA_TIMEOUT_MS=15000
GOWA_WEBHOOK_URL=https://whatsapp.eburon.ai/api/whatsapp/webhook
WHATSAPP_WEBHOOK_SECRET=replace_me

# Google Apps Script bridge
GOOGLE_APPS_SCRIPT_WEBAPP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GOOGLE_APPS_SCRIPT_TOOL_SECRET=replace_me_server_only

# Optional production frontend/backend split
VITE_BACKEND_URL=
